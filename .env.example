# Docker delivery settings. Copy this file to .env before starting Compose.
APP_PORT=8080
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_REASONING_EFFORT=low
MAX_CONCURRENT_TASKS=2
MAX_INPUT_CHARS=180000
DEFAULT_MAX_RETRIES=2

# Local Vite development settings. Docker overrides these at image build time.
VITE_AI_ADAPTER=mock
VITE_API_BASE_URL=/api

# Durable LangGraph script workflow. Keep "mock" for frontend-only use.
VITE_SCRIPT_WORKFLOW=mock
VITE_BACKEND_API_URL=/backend-api
BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional Vite development proxy configuration. Keep real values in .env.local.
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_MODEL=your-model-name
OPENAI_REASONING_EFFORT=low
# OPENAI_API_KEY=
